# ================================
# TRAZA E-SIGNATURE PLATFORM - ENVIRONMENT CONFIGURATION
# ================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control!
#
# SECURITY NOTES:
# - Use strong, randomly generated secrets (32+ characters)
# - Rotate secrets regularly in production
# - Use environment-specific credentials (dev/staging/prod)
# - Store production secrets in a secret manager (AWS Secrets Manager, HashiCorp Vault, etc.)
#
# Generate secure random secrets with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ================================

# Database (PostgreSQL)
# For production, use strong passwords and restrict network access
DATABASE_URL=postgresql://traza:traza@localhost:5432/traza

# Object Storage (S3-compatible: MinIO, AWS S3, DigitalOcean Spaces, etc.)
# PRODUCTION: Use strong credentials, NOT default 'minioadmin'!
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=traza-documents
S3_REGION=auto
S3_ACCESS_KEY_ID=your-strong-access-key-here
S3_SECRET_ACCESS_KEY=your-strong-secret-key-here

# Authentication Secrets
# CRITICAL: Generate unique, strong secrets for each environment!
# Must be at least 32 characters. Use base64-encoded random bytes.
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_32_CHARS_MIN
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_SECRET
SIGNING_TOKEN_SECRET=REPLACE_WITH_ANOTHER_STRONG_SECRET
PLATFORM_SECRET_KEY=REPLACE_WITH_PLATFORM_SECRET

# Blockchain (Polygon)
# SECURITY: Store private key in secret manager in production, NOT in .env!
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_PRIVATE_KEY=
CONTRACT_ADDRESS=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=sign@traza.dev

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Monitoring & Logging
SENTRY_DSN=
NODE_ENV=development
LOG_LEVEL=debug
PORT=4000
